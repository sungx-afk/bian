    return src;
};
var changeLink = function(str){
    if(!str){
        return '';
    }
    var isCode = str.indexOf('<pre');
    if(isCode < 0){
        var str2 = str.replace(/>([\s\S]*?)</g,function(word){
            return word.replace(/(http:\/\/[\w\-_]+|ftp:\/\/[\w\-_]+|https:\/\/[\w\-_]+|www)(\.[\w\-_]+)+([\w\-\.,@?^=%&amp;:/~\+#]*[\w\-\@?^=%&amp;/~\+#])?/gi,function(m){
                return '<a class="open_link" href="'+m+'" style="color:#000; text-decoration:underline;">'+m+'</a>';
            });
        });
        var box = str.split(/<|>/g);
        str2 = str2.replace(box[0],box[0].replace(/(http:\/\/[\w\-_]+|ftp:\/\/[\w\-_]+|https:\/\/[\w\-_]+|www)(\.[\w\-_]+)+([\w\-\.,@?^=%&amp;:/~\+#]*[\w\-\@?^=%&amp;/~\+#])?/gi,function(m){
            return '<a class="open_link" href="'+m+'" style="color:#000; text-decoration:underline;">'+m+'</a>';
        }));
        if(box[0] != box[box.length-1]){
            str2 = str2.replace(box[box.length-1],box[box.length-1].replace(/(http:\/\/[\w\-_]+|ftp:\/\/[\w\-_]+|https:\/\/[\w\-_]+|www)(\.[\w\-_]+)+([\w\-\.,@?^=%&amp;:/~\+#]*[\w\-\@?^=%&amp;/~\+#])?/gi,function(m){
                return '<a class="open_link" href="'+m+'" style="color:#000; text-decoration:underline;">'+m+'</a>';
            }));
        }
        return str2;
    }else{
        return str;
    }
}
var showTask = function(str){
    if(!str){
        return '';
    }
    var isCode = str.indexOf('<pre');
    //console.log(isCode);
    if(isCode < 0){
        var box = str.split(/<a[^>]*?>[^<]*?<\/a>/gi);
        if(box.length > 0){
            for(var i=0;i<box.length;i++){
                var temp = changeShowId(box[i]);
                str = str.replace(box[i],temp);
            }
            return str;
        }else{
            return changeShowId(str);
        }
    }else{
        return str;
    }
}
function changeShowId(str){
    var str2 = str.replace(/>([\s\S]*?)</g,function(word){
        return word.replace(/(([a-z]|[A-Z])[0-9]{3,8})/g,'<span class="get_showid_info" href="javascript:void(0);" title="">$1</span>');
    });
    var box = str.split(/<|>/g);
    str2 = str2.replace(box[0],box[0].replace(/(([a-z]|[A-Z])[0-9]{3,8})/g,'<span class="get_showid_info" href="javascript:void(0);" title="">$1</span>'));
    if(box.length > 1){
        str2 = str2.replace(box[box.length-1],box[box.length-1].replace(/(([a-z]|[A-Z])[0-9]{3,8})/g,'<span class="get_showid_info" href="javascript:void(0);" title="">$1</span>'));
    }
    return str2;
}

/*优化附件大小显示*/
function changeFileSize(size){
    var str = '';
    if(size < 1024){
        str = size + 'B'
    }else if(size > 1024 && size <1048576){
        str = (size/1024).toFixed(2) + 'K'
    }else{
        str = (size/1048576).toFixed(2) + 'M'
    }
    return str;
}
/*优化附件名字显示*/
function changeFilesName(str,ext){
    var totalLen = ext.length + 11;
    var lastLen = ext.length + 3;
    if(str.length > totalLen){
        var temp = str.substr(0,8) + '...' + str.substr(str.length-lastLen,lastLen);
        return temp;
    }else{
        return str;
    }
}





function addZero(v) {if (v < 10) return '0' + v;return v.toString();}




function changeCronToString(cron,lifecycle){//cron表达式转换为描述文字
    var box = cron.split(' ');
    console.log(box);
    var result = '';
    var type = '';
    /*秒  分  时  日  月  周  年*/
    if((box[5] == '2-6' && box[3] == '?' || box[5] == '?' && box[3] == '*') && box[4] == '*'){
        console.log("按天");
        type = 'days';
        var date = new Date();
        date.setHours(box[2]);
        date.setMinutes(box[1]);
        date.setSeconds(box[0]);
        var times = Date.parse(date)+parseInt(lifecycle);
        var endDate = new Date(times);
        if(box[5] == '2-6'){
            //result = '每个工作日的'+addZero(box[2])+':'+addZero(box[1])+'到'+addZero(endDate.getHours())+':'+addZero(endDate.getMinutes());
            result = '每个工作日的'+addZero(box[2])+':'+addZero(box[1])+'生成';
        }else{
            //result = '每天的'+addZero(box[2])+':'+addZero(box[1])+'到'+addZero(endDate.getHours())+':'+addZero(endDate.getMinutes());
            result = '每天的'+addZero(box[2])+':'+addZero(box[1])+'生成';
        }
    }else if(box[3] == '?' && box[5] != '2-6' && box[4] == '*'){
        type = 'weeks'
        console.log('按周');
        var date = new Date();
        date.setHours(box[2]);
        date.setMinutes(box[1]);
        date.setSeconds(box[0]);
        var times = Date.parse(date)+parseInt(lifecycle);
        var endDate = new Date(times);
        result = '每周'
        var week = box[5].split(',');
        for(var i=0;i<week.length;i++){
            result = result + week[i]
            if(i<week.length-1){
                result = result + ',';
            }
        }
        //result = result+'的' +addZero(box[2])+':'+addZero(box[1])+'到'+addZero(endDate.getHours())+':'+addZero(endDate.getMinutes());
        result = result+'的' +addZero(box[2])+':'+addZero(box[1])+'生成';
    }else if(box[5] == '?' && box[4] == '*' && box[3] != '*' && box[3] != '?'){
        console.log("按月");
        type = 'month';
        var date = new Date();
        date.setDate(box[3]);
        date.setHours(box[2]);
        date.setMinutes(box[1]);
        date.setSeconds(box[0]);
        var times = Date.parse(date)+parseInt(lifecycle);
        var endDate = new Date(times);

        //result = '每个月的第'+box[3]+'天'+addZero(box[2])+':'+addZero(box[1])+'到每个月的第'+endDate.getDate()+'天'+addZero(endDate.getHours())+':'+addZero(endDate.getMinutes());
        result = '每个月的第'+box[3]+'天'+addZero(box[2])+':'+addZero(box[1])+'生成';
    }else if(box[4] != '*'){
        type = 'years';
        console.log("按年");
        var date = new Date();
        date.setMonth(parseInt(box[4],10)-1);
        date.setDate(box[3]);
        date.setHours(box[2]);
        date.setMinutes(box[1]);
        date.setSeconds(box[0]);
        var times = Date.parse(date)+parseInt(lifecycle);
        var endDate = new Date(times);
        //result = '每年的'+box[4]+'月'+box[3]+'日'+addZero(box[2])+':'+addZero(box[1])+'到每年的'+(endDate.getMonth()+1)+'月'+endDate.getDate()+'日'+addZero(endDate.getHours())+':'+addZero(endDate.getMinutes());
        result = '每年的'+box[4]+'月'+box[3]+'日'+addZero(box[2])+':'+addZero(box[1])+'生成';

    }
    var temp = {
        description:result,
        start:Date.parse(date),
        end:Date.parse(endDate),
        type:type
    }
    console.log(temp);
    return temp;
}






