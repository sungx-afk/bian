/*右键菜单*/
function show_right_menu(self){
     var selfHtml = self.html();
    var selfSelectedHtml = self.selectedHtml();
    var editorHtml = '';
    if(window.editor){
        editorHtml =  window.editor.html();
    }
    var commentEditorHtml='';
    if(window.commentEditor){
        commentEditorHtml = window.commentEditor.html();
    }
    var editorName = 'editor';
    if(commentEditorHtml == selfHtml){
        editorName = 'commentEditor';
    }else{
        editorName = 'editor'
    }
    var hashtml = 0;
    if(selfHtml != ''){
        hashtml = 1;
    }
    var hasselected = 0;
    if(selfSelectedHtml != ''){
        hasselected = 1;
    }
    var apiName = 'show_right_menu';
    var params = {
            "hashtml":hashtml,
            "hasselected":hasselected,
            "editor":editorName
        }
    callClient(apiName,params);
}
/*设置cookie*/
function setCookie(cname,cvalue,exdays){
    if(!exdays){
        exdays = 365;
    }
    var d = new Date();
    d.setTime(d.getTime()+(exdays*24*60*60*1000));
    var expires = "expires="+d.toGMTString();
    document.cookie = cname + "=" + cvalue + "; " + expires;
}
/*取cookie*/
function getCookie(cname){
    var name = cname + "=";
    var ca = document.cookie.split(';');
    for(var i=0; i<ca.length; i++)
      {
      var c = ca[i].trim();
      if (c.indexOf(name)==0) return c.substring(name.length,c.length);
    }
    return "";
}
/*数组操作原型扩展，删除某一项*/
Array.prototype.del=function(n) {　//n表示第几项，从0开始算起。
//prototype为对象原型，注意这里为对象增加自定义方法的方法。
　if(n<0)　//如果n<0，则不进行任何操作。
　　return this;
　else
　　return this.slice(0,n).concat(this.slice(n+1,this.length));
　　/*
　　　concat方法：返回一个新数组，这个新数组是由两个或更多数组组合而成的。
　　　　　　　　　这里就是返回this.slice(0,n)/this.slice(n+1,this.length)
　　 　　　　　　组成的新数组，这中间，刚好少了第n项。
　　　slice方法： 返回一个数组的一段，两个参数，分别指定开始和结束的位置。
　　*/
}
/*数组去重*/
Array.prototype.unique = function(){
 var res = [];
 var json = {};
 for(var i = 0; i < this.length; i++){
  if(!json[this[i]]){
   res.push(this[i]);
   json[this[i]] = 1;
  }
 }
 return res;
}


/*删除数组里面的某个值*/
Array.prototype.remove = function(val) {
var index = this.indexOf(val);
if (index > -1) {
this.splice(index, 1);
}
};

/*获取两个数组里面相同的值*/
Array.prototype.same = function(arr2){
    var arr1 = this;
    var arr3=[];
    for(var s in arr1){
        for(var x in arr2){
            if(arr1[s]==arr2[x]){
                arr3.push(arr1[s]);
            }
        }
    }
    return arr3;
}
/*过滤掉数组里面的方法*/
Array.prototype.filterDataByType = function(dataType){
    var arr = [];
    for(var i=0;i<this.length;i++){
        if(typeof this[i] == dataType){
            arr.push(this[i]);
        }
    }
    return arr;
}
/*存储localstorage*/

function setStorage(cname,cvalue){
    var isStorage = isLocalStorageNameSupported();
    if (window.localStorage && isStorage) {
        localStorage.setItem(cname, cvalue);
    } else {
        setCookie(cname,cvalue);
    }
}

function getStorage(cname){
    var isStorage = isLocalStorageNameSupported();
    if (window.localStorage && isStorage) {
        var str = localStorage.getItem(cname);
        return str;
    } else {
        getCookie(cname);
    }
}
function isLocalStorageNameSupported() {
    var testKey = 'test', storage = window.sessionStorage;
    try {
        storage.setItem(testKey, '1');
        storage.removeItem(testKey);
        return true;
    } catch (error) {
        return false;
    }
}


function storagedbToken (dbname) {
    var storage = window.localStorage;
    var KEY = 'token_user_';
    var DAY = 0;
    dbname = KEY + dbname;
    return {
        find: function(){
            if(storage && typeof storage === 'object'){
                return storage[dbname] ? JSON.parse(storage[dbname]) : null;
            }else{
                return null;
            }
        },
        insert: function(data){
            this.remove();
            data['_time'] = new Date().getTime();
            storage.setItem(dbname, JSON.stringify(data));
        },
        remove: function(){
            var now = new Date().getTime();
            for(var key in storage){
                var isToken = key.indexOf(KEY);
                if(key !== dbname && isToken >= 0){
                    var isExpire = now - JSON.parse(storage[key])._time > DAY;
                    if(isExpire){
                        storage.removeItem(key);
                    }
                }
            }
        }
    }
}