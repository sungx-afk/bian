  var init = function() {
    var line = '.task-line-' + task.uuid;
    var tasksWrapper = d3.select(line);
    d3.select('.menuBody').remove();
    if (config.readonly) {
      return false;
    }
    menuBody = tasksWrapper.append('g')
      .attr('class', 'menuBody')
      .attr('id', 'menuBody').attr('transform', function() {
        return 'translate(' + xScale(task.startDate) + ', ' + 0 + ')';
      });
  }

