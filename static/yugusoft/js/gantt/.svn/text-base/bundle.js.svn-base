"use strict";

module.exports = function(d3) {
  var log = {

  };
  log.build = function(id) {
    log = {
      id: id,
      st: new Date().getTime(),
      arr: [],
    };
    return this;
  }
  log.info = function(str) {
    var t = new Date().getTime();
    var cost = t-log.st;
    log.arr.push(str + '=' + cost + 'ms ');
  }
  log.out = function(){
    ////console.log(log.id+'===='+log.arr.join(', '));
  }
  return log;
}
